{
  "manifest_version": 2,
  "name": "Chamilo Quiz Autopilot",
  "version": "1.0.0",
  "description": "Answers Chamilo quiz questions from your own answer key (works with shuffled questions and options), clicks Next, and asks you before ending the test.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_action": {
    "default_title": "Quiz Autopilot",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*main/exercise/*"
      ],
      "js": [
        "matcher.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chamilo-quiz-autopilot@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
